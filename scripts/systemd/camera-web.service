[Unit]
Description=Camera AI Frontend Web Management
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/yolov26-nhandien-biensoxe/frontend
Environment="PATH=/home/jetson/yolov26-nhandien-biensoxe/venv/bin:/usr/local/cuda/bin:/usr/bin"
Environment="PYTHONPATH=/home/jetson/yolov26-nhandien-biensoxe"
ExecStart=/home/jetson/yolov26-nhandien-biensoxe/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
