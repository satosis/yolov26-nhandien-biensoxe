# syntax=docker/dockerfile:1
FROM python:3.10-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Build tools for dlib/face-recognition compilation
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config gcc g++ make \
    libopenblas-dev liblapack-dev libx11-dev \
    libgtk-3-dev libboost-python-dev libboost-thread-dev \
    && rm -f /etc/apt/apt.conf.d/docker-clean

# Layer: Dependencies (cached)
# Note: Context is project root (via docker-compose.yml)
COPY backend/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --wheel-dir /usr/src/app/wheels -r requirements.txt


# ---- Final runtime image ----
FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Ho_Chi_Minh \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH=/app

# Runtime C-libraries only
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 libopenblas0 libpq5 tzdata \
    && rm -f /etc/apt/apt.conf.d/docker-clean

# Install wheels
COPY --from=builder /usr/src/app/wheels /wheels
RUN pip install --no-cache /wheels/* --compile && rm -rf /wheels

# Copy application source
# We copy everything from root to preserve the 'backend' package structure
COPY . .

# Run from the root so that 'from backend.core...' imports work correctly
CMD ["python", "-u", "backend/main.py"]
