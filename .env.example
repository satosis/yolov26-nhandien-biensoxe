# Camera AI Parking - Environment Variables
# Copy this file to .env and fill real values.

# PostgreSQL
DATABASE_URL=postgresql://camera_user:password@localhost:5432/camera_ai
POSTGRES_DB=camera_ai
POSTGRES_USER=camera_user
POSTGRES_PASSWORD=

# Tuya door control fallback. Prefer configuring doors in the webapp.
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=
