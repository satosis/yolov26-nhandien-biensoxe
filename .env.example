# Existing PostgreSQL on 127.0.0.1:5432; use the same password in both fields.
# URL-encode special characters in the password portion of DATABASE_URL.
DB_USERNAME=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:<url-encoded-password>@127.0.0.1:5432/camera_ai
SESSION_SECRET=replace-with-a-long-random-secret

# Google Maps & Google OAuth Credentials
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public Website Domain / Base URL (dùng cho link Telegram alert, sitemap, email)
# Ví dụ khi chạy production: SITE_URL=https://dailoxanh.vn
# Để trống nếu muốn hệ thống tự động nhận diện theo request host thực tế
SITE_URL=http://localhost:8000

