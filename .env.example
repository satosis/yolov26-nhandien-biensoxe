# ═══════════════════════════════════════════════════════════════
# Camera AI Parking — Environment Variables
# Copy file này thành .env và điền giá trị thật
# ═══════════════════════════════════════════════════════════════

# --- PostgreSQL (bắt buộc) ---
DATABASE_URL=postgresql://camera_user:password@localhost:5432/camera_ai
POSTGRES_DB=camera_ai
POSTGRES_USER=camera_user
POSTGRES_PASSWORD=

# --- Session Secret (bắt buộc cho production) ---
SESSION_SECRET=

# --- Telegram Bot (fallback — ưu tiên cấu hình qua webapp /telegram) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IMPORTANT=
TELEGRAM_CHAT_REGULAR=
TELEGRAM_ALLOWED_USERS=

# --- Tuya Door Control (fallback — ưu tiên cấu hình qua webapp /rolling_doors) ---
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=
