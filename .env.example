# Existing PostgreSQL on 127.0.0.1:5432; use the same password in both fields.
# URL-encode special characters in the password portion of DATABASE_URL.
DB_USERNAME=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:<url-encoded-password>@127.0.0.1:5432/camera_ai
SESSION_SECRET=replace-with-a-long-random-secret

# Google Maps & Google OAuth Credentials
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public App URL (domain duy nhất của hệ thống; dùng cho link Telegram, Facebook, Zalo, email, hóa đơn, OAuth)
APP_URL=https://app.kubenetes.store

# Cloudflare Named Tunnel: token tao trong Zero Trust > Networks > Tunnels; dia chi cong khai lay tu APP_URL o tren
CLOUDFLARE_TUNNEL_TOKEN=

# SePay webhook (/  api/webhook/sepay): API Key trong SePay > Webhook > Bao mat la gia tri SESSION_SECRET
