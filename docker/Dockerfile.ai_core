# syntax=docker/dockerfile:1
FROM python:3.10-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Build tools for dlib/face-recognition compilation
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config gcc g++ make \
    libopenblas-dev liblapack-dev libx11-dev \
    libgtk-3-dev libboost-python-dev libboost-thread-dev \
    && rm -f /etc/apt/apt.conf.d/docker-clean

# Layer 1: Heavy deps (rarely change — cached for weeks)
COPY requirements-heavy.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --wheel-dir /usr/src/app/wheels-heavy -r requirements-heavy.txt

# Layer 2: Light deps (change more often)
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --wheel-dir /usr/src/app/wheels-light -r requirements.txt


# ---- Final runtime image ----
FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Ho_Chi_Minh

# Runtime C-libraries only
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 libopenblas0 libpq5 tzdata \
    && rm -f /etc/apt/apt.conf.d/docker-clean

# Install heavy wheels first (cached layer)
COPY --from=builder /usr/src/app/wheels-heavy /wheels-heavy
RUN pip install --no-cache /wheels-heavy/* --compile && rm -rf /wheels-heavy

# Install light wheels (smaller, faster rebuild)
COPY --from=builder /usr/src/app/wheels-light /wheels-light
RUN pip install --no-cache /wheels-light/* --compile && rm -rf /wheels-light

# Copy application source
COPY . .

CMD ["python", "-u", "main.py"]
